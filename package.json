{
  "name": "natheelco-taskflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "cash-bank-app"
  ],
  "scripts": {
    "predev": "npm run build:cash-bank",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run build:cash-bank",
    "build": "vite build",
    "build:cash-bank": "npm run build --workspace=saudi-cash-control-dashboard -- --base=/cash-bank/ --outDir=../public/cash-bank --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
